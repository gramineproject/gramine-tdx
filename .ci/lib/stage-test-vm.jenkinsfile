stage('test-vm') {
    try {
        timeout(time: 5, unit: 'MINUTES') {
            // TODO: re-enable CI-Examples in this stage after identifying
            // examples compatible with the VM environment:
            // https://github.com/gramineproject/gramine-tdx/issues/66
        }
    } finally {
        sh '''
            # Clean up vhostfs pid files
            for f in /tmp/gramine_vhostfs_*.pid; do
                [ -e "$f" ] || continue
                pid=$(cat "$f" 2>/dev/null)
                [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
                rm -f "$f"
            done

            # Clean up vhostfs sockets
            rm -f /tmp/gramine_vhostfs_*
        '''
    }
}
